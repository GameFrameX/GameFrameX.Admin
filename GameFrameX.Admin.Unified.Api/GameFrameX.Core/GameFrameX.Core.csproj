        <ProjectReference Include="..\GameFrameX.Core.Utility\GameFrameX.Core.Utility.csproj" />
        <ProjectReference Include="..\ObjectStorage\GameFrameX.ObjectStorage.Abstract\GameFrameX.ObjectStorage.Abstract.csproj" />
