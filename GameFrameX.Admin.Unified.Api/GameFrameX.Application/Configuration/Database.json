{
  // 数据库连接默认配置（三 host 共享一个 main 主库）
  // 1. 默认 SQLite 仅限本地开发/调试（零外部依赖，开箱即用）；生产【严禁】SQLite，请用 PostgreSQL。
  //    SQLite 路径相对进程工作目录解析——请在仓库根执行 dotnet run，三个 host 共享 ./db/ 下的同一库文件（WAL 由启动初始化以 PRAGMA 开启）。
  // 2. 切换数据库 / 覆盖：成对提供启动参数 --DbType + --ConnectionString（环境变量形态 DBTYPE + CONNECTIONSTRING，docker-compose 即此用法，命令行优先）；
  //    DbType 全部取值与各库连接串写法速查（折叠表）见后端 README 数据库段（摘自 SqlSugar 官方文档 donet5.com「数据库特色」）。
  // 3. 主库标识固定 main（无需也无法配置其他连接）；所有受管业务表在主库初始化。
  // 4. 初始化开关默认值在代码中：建库/建表/种子初始化默认全开（仅 EnableIncreSeed 默认 false），无需在本文件配置；
  //    如需关闭某开关，在 DbConnection 节下显式加回 DbSettings / TableSettings / SeedSettings 节点覆盖。
  "DbConnection": {
    "EnableConsoleSql": false,
    // 启用控制台打印SQL
    "DbType": "Sqlite",
    "ConnectionString": "DataSource=./db/GameFrameX.Admin.db;"
    // 库连接字符串；ConfigId 固定 main，无需配置
  }
}
