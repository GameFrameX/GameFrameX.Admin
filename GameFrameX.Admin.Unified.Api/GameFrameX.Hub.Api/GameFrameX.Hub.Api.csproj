<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <AssemblyName>GameFrameX.Hub.Api</AssemblyName>
        <RootNamespace>GameFrameX.Hub.Api</RootNamespace>
        <PackageId>GameFrameX.Hub.Api</PackageId>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <DocumentationFile>bin\Debug\net10.0\GameFrameX.Hub.Api.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <!-- C267：中间件 internal 纯函数（签名头解析 / v2 验签）单测可见，与 Core 同惯例 -->
        <InternalsVisibleTo Include="GameFrameX.Core.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GameFrameX.Application.Game\GameFrameX.Application.Game.csproj"/>
        <ProjectReference Include="..\GameFrameX.Core\GameFrameX.Core.csproj"/>
        <ProjectReference Include="..\GameFrameX.Core.SqlSugar\GameFrameX.Core.SqlSugar.csproj"/>
        <ProjectReference Include="..\GameFrameX.Core.BaseInputOutput\GameFrameX.Core.BaseInputOutput.csproj"/>
        <ProjectReference Include="..\GameFrameX.Core.Extension\GameFrameX.Core.Extension.csproj"/>
        <ProjectReference Include="..\GameFrameX.Entity\GameFrameX.Entity.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="GameFrameX.Foundation.Options" Version="$(FoundationVersion)"/>
        <PackageReference Include="IP2Location.IPGeolocation" Version="9.1.1"/>
        <PackageReference Include="Sentry.AspNetCore" Version="6.6.0"/>
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.2.3"/>
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3"/>
    </ItemGroup>

    <!-- C279：共享 Database.json 默认连接配置（文件链接复制进输出目录，无 ProjectReference，不破坏「业务层不引用 host」分层） -->
    <ItemGroup>
        <None Include="..\GameFrameX.Application\Configuration\Database.json" Link="Configuration\Database.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
