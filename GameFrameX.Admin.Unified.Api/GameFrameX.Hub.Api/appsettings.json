{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "SnowFlake": {
    "WorkerId": 2
    // 工作节点Id 0-7（紧凑短 ID 布局，2026-09-15 决策冻结）。同库写入的全部实例（Web.Api 多副本 / Hub / Client）
    // 必须互斥配置（Web.Api 配置 1 / Client 兜底 3），越界 0-7 启动期显式失败——单数据中心同库写入实例上限 8。
    // 环境变量入口：SnowFlake__WorkerId
  },

  // Grafana Cloud OpenTelemetry：OTLP 统一三信号（traces/metrics/logs，logs 自动入 Loki）。
  // 三者齐全才启用；凭证不进 git，本地/生产用环境变量 OpenTelemetry__Endpoint / OpenTelemetry__UserName / OpenTelemetry__ApiKey 注入
  "OpenTelemetry": {
    "Endpoint": "",
    "UserName": "",
    "ApiKey": ""
  },

  "JWTSettings": {
    "ValidateIssuerSigningKey": true,
    // 签名密钥不入 git：部署时用环境变量 JWTSettings__IssuerSigningKey 注入，
    // 值必须与主库 system_config_entity(platform_jwt_settings) 的 issuerSigningKey 一致（平台 JWT 首次启动随机生成）；
    // compose 场景写入 Api 目录 .env 的 GFX_HUB_JWT_SIGNING_KEY。Issuer/Audience 已对齐平台默认值 GameFrameX.Admin。
    "IssuerSigningKey": "",
    "ValidateIssuer": true,
    "ValidIssuer": "GameFrameX.Admin",
    "ValidateAudience": true,
    "ValidAudience": "GameFrameX.Admin",
    "ValidateLifetime": true,
    "ClockSkew": 5,
    "Algorithm": "HS256"
  }
}
