{
  "ConfigurationScanDirectories": [
    "Configuration",
    ""
  ],
  // 扫描配置文件json文件夹（自动合并该文件夹里面所有json文件）

  // C172（GFX-175）：以下主机与启动框架配置迁入作为运行时事实源。
  // 仅迁配置事实源，不改路由 / CORS / 异常 / SnowFlake 运行时语义；密码哈希统一 Argon2id（C214，无启动期密钥注入），GameServerSettings 由区服级 DB 配置承接（C173 / C175）。
  "AllowedHosts": "*",
  "AppSettings": {
    "InjectSpecificationDocument": true
    // 生产环境是否开启Swagger
  },
  "SnowFlake": {
    "WorkerId": 1
    // 工作节点Id 0-7（紧凑短 ID 布局，2026-09-15 决策冻结）。同库写入的全部实例（Web.Api 多副本 / Hub / Client）
    // 必须互斥配置（Hub 兜底 2 / Client 兜底 3），越界 0-7 启动期显式失败——单数据中心同库写入实例上限 8。
    // 环境变量入口：SnowFlake__WorkerId
  },
  "TenantMenuSync": {
    "WorkerConcurrency": 4,
    // 租户菜单同步消费者并发数（C353）
    "ScanIntervalSeconds": 1800
    // 周期兜底扫描间隔（秒，下限 60）
  },

  // Grafana Cloud OpenTelemetry：OTLP 统一三信号（traces/metrics/logs，logs 自动入 Loki）。
  // 三者齐全才启用；凭证不进 git，本地/生产用环境变量 OpenTelemetry__Endpoint / OpenTelemetry__UserName / OpenTelemetry__ApiKey 注入
  "OpenTelemetry": {
    "Endpoint": "",
    "UserName": "",
    "ApiKey": ""
  }
}
