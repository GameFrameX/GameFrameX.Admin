    <ItemGroup>
        <ProjectReference Include="..\GameFrameX.Application.Game\GameFrameX.Application.Game.csproj"/>
        <ProjectReference Include="..\GameFrameX.Core.Extension\GameFrameX.Core.Extension.csproj"/>
        <ProjectReference Include="..\GameFrameX.Core.SqlSugar\GameFrameX.Core.SqlSugar.csproj"/>
        <ProjectReference Include="..\Email\GameFrameX.Email.Abstract\GameFrameX.Email.Abstract.csproj"/>
        <ProjectReference Include="..\Email\GameFrameX.Email.TencentSes\GameFrameX.Email.TencentSes.csproj"/>
        <ProjectReference Include="..\Email\GameFrameX.Email.Smtp\GameFrameX.Email.Smtp.csproj"/>
        <ProjectReference Include="..\Payment\GameFrameX.Payment.AliPay\GameFrameX.Payment.AliPay.csproj"/>
        <ProjectReference Include="..\Payment\GameFrameX.Payment.Apple.AppStoreServer\GameFrameX.Payment.Apple.AppStoreServer.csproj"/>
        <ProjectReference Include="..\Payment\GameFrameX.Payment.Apple\GameFrameX.Payment.Apple.csproj"/>
        <ProjectReference Include="..\Payment\GameFrameX.Payment.Google\GameFrameX.Payment.Google.csproj"/>
        <ProjectReference Include="..\Payment\GameFrameX.Payment.Wechat\GameFrameX.Payment.Wechat.csproj"/>
        <ProjectReference Include="..\Payment\GameFrameX.Payment.Xsolla\GameFrameX.Payment.Xsolla.csproj"/>
