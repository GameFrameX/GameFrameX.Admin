# =====================================================================================
# GameFrameX Admin —— 仓库根 .env 模板（docker-compose 变量覆盖入口）
# 复制为 .env 后按需填写；未填写的变量使用 docker-compose.yml 中的默认值。
# .env 不进 git（见 .gitignore）；postgres-data 数据目录同样不进 git。
# =====================================================================================

# ── PostgreSQL（首次初始化数据目录时生效；改老库密码的步骤见 compose 文件顶部）──
# POSTGRES_USER=gameframex
# POSTGRES_PASSWORD=GameFrameX@Local2026
# POSTGRES_PORT=5432
# POSTGRES_HOST=postgres            # 换用宿主机已装 PostgreSQL 时改为 host.docker.internal

# ── 共享主库连接（覆盖 x-main-db 默认连接串时成对配置）──
# DBTYPE=PostgreSQL
# CONNECTIONSTRING=Host=postgres;Port=5432;Database=gameframex_admin;Username=gameframex;Password=...

# ── 运行凭证加密（留空 = 明文降级模式；设置后三 host 同值且不可再变更）──
# GAMEFRAMEX_SECRET_ENCRYPTION_KEY=


# ── Hub API JWT 验签密钥 ──
# 与主库 platform_jwt_settings（system_config_entity 表）的 issuerSigningKey 一致；
# 留空 = hub 可启动但所有 JWT 校验失败。查看当前平台密钥：
#   docker exec gameframex-postgres psql -U gameframex -d gameframex_admin -t -A \
#     -c "SELECT value FROM system_config_entity WHERE code='platform_jwt_settings';"
# GFX_HUB_JWT_SIGNING_KEY=

# ── 前端运行时 API 地址（entrypoint 写入 config/config.js；远端部署时改浏览器可达地址）──
# WEB_VUE_API_URL=http://127.0.0.1:20802

# ── 新装首个业务管理员种子引导（C406 / F3；成对设置才生效）──
# 仅当主库中还没有任何业务管理员账号时，web-api 启动期会创建该账号并绑定 sys_admin 角色
# （授权全部非超管菜单）。账号已存在则忽略并告警；密码须满足平台密码强度策略，否则启动失败。
# GAMEFRAMEX_ADMIN_INITIAL_ACCOUNT=admin
# GAMEFRAMEX_ADMIN_INITIAL_PASSWORD=<初始密码，请自行设置>

# ── Grafana Cloud OpenTelemetry（三者齐全才启用；凭证见 Grafana Cloud Portal）──
# OTEL_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
# OTEL_USER=<Stack Instance ID>
# OTEL_API_KEY=<API Key / glc_ token>

# ── docker-compose.admin.yml（Admin 独立栈）隔离覆盖 ──
# 仅影响 docker compose -f docker-compose.admin.yml；未设置时用该文件内默认值。
# 与统一栈并行运行时，用它把独立栈的宿主机端口与数据目录隔开（本地 E2E / 多实例必用）。
# ADMIN_WEB_PORT=20802
# ADMIN_CLIENT_PORT=20808
# ADMIN_HUB_PORT=20806
# 统一栈占用 5432 时，可用空闲端口启动独立栈，例如：
# POSTGRES_PORT=15432 docker compose -f docker-compose.admin.yml up -d
# （后续再次 up 需沿用相同覆盖值；也可把 POSTGRES_PORT=15432 写进 .env 后直接 up）
# 并行运行时取消下一行注释：默认目录与统一栈相同，需换成独立数据目录。
# ADMIN_POSTGRES_DATA_DIRECTORY=./postgres-data-admin
