{
  "name": "gameframex.admin.vue",
  "version": "2.4.33",
  "description": "vue3 vite next admin template",
  "author": "AlianBlank <https://github.com/AlianBlank>",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run lint:i18n && cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx,vue}\"",
    "lint-fix": "pnpm run lint -- --fix",
    "format": "prettier --check \"src/**/*.{js,jsx,ts,tsx,vue,scss,css,json,md}\"",
    "format-fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx,vue,scss,css,json,md}\"",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint:i18n": "node scripts/check-i18n-keys.mjs",
    "check:permKeys": "node scripts/check-permission-keys.mjs",
    "check:errorCodes": "node scripts/check-error-codes.mjs",
    "sync:errorCodes": "node scripts/sync-error-codes.mjs",
    "gen:api": "node scripts/gen-api.mjs",
    "check:routes": "node scripts/check-frontend-standards.mjs routes",
    "check:permissions": "node scripts/check-frontend-standards.mjs permissions",
    "check:api": "node scripts/check-frontend-standards.mjs api",
    "check:text": "node scripts/check-frontend-standards.mjs text",
    "check:componentNames": "node scripts/check-frontend-standards.mjs componentNames",
    "check:frontend": "node scripts/check-frontend-standards.mjs all && node scripts/check-permission-keys.mjs",
    "check:frontend:self-test": "node scripts/check-frontend-standards.mjs self-test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headless": "E2E_HEADLESS=1 playwright test",
    "test:e2e:list": "playwright test --list",
    "test:e2e:report": "playwright show-report e2e/.e2e/report",
    "quality": "pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run build && pnpm run check:frontend"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
