    "pinia-plugin-persistedstate": "^4.7.1",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primelocale": "^2.3.2",
    "primevue": "^4.5.5",
    "print-js": "^1.6.0",
    "qs": "^6.15.1",
    "screenfull": "^6.0.2",
    "sortablejs": "^1.15.0",
    "splitpanes": "^4.0.4",
    "vue": "^3.5.33",
    "vue-clipboard3": "^2.0.0",
    "vue-demi": "^0.14.10",
    "vue-grid-layout": "3.0.0-beta1",
    "vue-i18n": "^11.4.0",
    "vue-json-pretty": "^2.6.0",
    "vue-plugin-hiprint": "^0.0.60",
    "vue-router": "^5.0.6",
    "vue-signature-pad": "^3.0.2",
    "vue3-tree-org": "^4.2.2",
    "vue3-ts-jsoneditor": "^2.11.2",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
