    "axios": "^1.15.2",
    "countup.js": "^2.8.0",
    "cropperjs": "^1.6.1",
    "dompurify": "2.5.9",
    "echarts": "^6.0.0",
    "echarts-gl": "^2.0.9",
    "echarts-wordcloud": "^2.1.0",
    "handlebars": "^4.7.9",
